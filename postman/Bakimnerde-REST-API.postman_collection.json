{
  "info": {
    "_postman_id": "77cf24b5-bakimnerde-3plus1-2026",
    "name": "Bakımnerde REST API · 3+1 Rol ve Canlı Operasyon",
    "description": "Bakımnerde, CPO, taşeron yönetimi ve yalnız mobil saha rollerini; tenant, kullanıcı, iş, kanıt, mesaj, ek talep, fiyat, cüzdan ve denetim kayıtlarıyla sınar. Collection Runner sırasıyla çalıştırılmalıdır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "platformToken", "value": "" },
    { "key": "cpoToken", "value": "" },
    { "key": "contractorToken", "value": "" },
    { "key": "fieldToken", "value": "" },
    { "key": "fieldUserId", "value": "" },
    { "key": "cpoTenantId", "value": "" },
    { "key": "contractorTenantId", "value": "" },
    { "key": "createdTenantId", "value": "" },
    { "key": "createdUserId", "value": "" },
    { "key": "createdJobId", "value": "" },
    { "key": "createdStationId", "value": "" },
    { "key": "createdChargePointId", "value": "" },
    { "key": "additionalRequestId", "value": "" },
    { "key": "createdPriceId", "value": "" },
    { "key": "walletTransactionId", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "futureAppointment", "value": "" },
    { "key": "futureGivenDuration", "value": "" },
    { "key": "futureSupplyDeadline", "value": "" }
  ],
  "event": [{
    "listen": "prerequest",
    "script": { "type": "text/javascript", "exec": [
      "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', String(Date.now()));",
      "pm.collectionVariables.set('futureAppointment', new Date(Date.now() + 3 * 86400000).toISOString());",
      "pm.collectionVariables.set('futureGivenDuration', new Date(Date.now() + 14 * 86400000).toISOString());",
      "pm.collectionVariables.set('futureSupplyDeadline', new Date(Date.now() + 5 * 86400000).toISOString());"
    ] }
  }],
  "item": [
    {
      "name": "00 · Sistem Sağlığı",
      "item": [
        {
          "name": "Canlılık",
          "request": { "method": "GET", "url": "{{baseUrl}}/health-live" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('API canlı',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Hazırlık ve MongoDB",
          "request": { "method": "GET", "url": "{{baseUrl}}/health-ready" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('MongoDB hazır',()=>pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "01 · Ayrılmış Giriş Kanalları",
      "item": [
        {
          "name": "Bakımnerde Özel Girişi",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"admin@bakimnerde.com\",\"password\":\"Bakimnerde!2026\"}" }, "url": "{{baseUrl}}/auth-platform-login" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('PLATFORM_OWNER',()=>{pm.response.to.have.status(200);pm.expect(b.data.principal.role).to.eql('PLATFORM_OWNER');});pm.collectionVariables.set('platformToken',b.data.token);"] } }]
        },
        {
          "name": "CPO Şirket Girişi",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"operasyon@wattarya.test\",\"password\":\"Bakimnerde!2026\"}" }, "url": "{{baseUrl}}/auth-company-login" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('CPO şirket kanalı',()=>pm.expect(b.data.principal.tenantType).to.eql('CPO'));pm.collectionVariables.set('cpoToken',b.data.token);pm.collectionVariables.set('cpoTenantId',b.data.principal.tenantId);"] } }]
        },
        {
          "name": "Taşeron Yönetim Girişi",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"yonetici@wattaryateknik.test\",\"password\":\"Bakimnerde!2026\"}" }, "url": "{{baseUrl}}/auth-company-login" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('CONTRACTOR_ADMIN',()=>pm.expect(b.data.principal.role).to.eql('CONTRACTOR_ADMIN'));pm.collectionVariables.set('contractorToken',b.data.token);pm.collectionVariables.set('contractorTenantId',b.data.principal.tenantId);"] } }]
        },
        {
          "name": "Saha Mobil Girişi",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"saha@wattaryateknik.test\",\"password\":\"Bakimnerde!2026\"}" }, "url": "{{baseUrl}}/auth-field-login" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('FIELD_WORKER mobil kanalı',()=>pm.expect(b.data.principal.role).to.eql('FIELD_WORKER'));pm.collectionVariables.set('fieldToken',b.data.token);pm.collectionVariables.set('fieldUserId',b.data.principal.userId);"] } }]
        },
        {
          "name": "Bakımnerde Açık Şirket Girişinden Reddedilir",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"admin@bakimnerde.com\",\"password\":\"Bakimnerde!2026\"}" }, "url": "{{baseUrl}}/auth-company-login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Gizli Bakımnerde kanalı',()=>pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Saha Web Panel Girişinden Reddedilir",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"saha@wattaryateknik.test\",\"password\":\"Bakimnerde!2026\"}" }, "url": "{{baseUrl}}/auth-company-login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Saha web paneline giremez',()=>pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Aktif Oturum Kimliği",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "url": "{{baseUrl}}/auth-me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Token kimliği doğrulandı',()=>pm.expect(pm.response.json().data.role).to.eql('PLATFORM_OWNER'));"] } }]
        }
      ]
    },
    {
      "name": "02 · Tenant ve Kullanıcı CRUD",
      "item": [
        {
          "name": "Tenant Listesi ve 3 Tür Denetimi",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "url": "{{baseUrl}}/tenants-list" },
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json().data;pm.test('Yalnız PLATFORM/CPO/CONTRACTOR',()=>pm.expect(r.every(x=>['PLATFORM','CPO','CONTRACTOR'].includes(x.type))).to.be.true);"] } }]
        },
        {
          "name": "Geçici CPO Oluştur",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman CPO {{runId}}\",\"tenantKey\":\"postman-cpo-{{runId}}\",\"type\":\"CPO\",\"contactEmail\":\"cpo-{{runId}}@test.local\",\"contactPhone\":\"02120000000\",\"adminName\":\"Postman Yönetici\",\"adminEmail\":\"admin-cpo-{{runId}}@test.local\",\"adminPassword\":\"Postman!2026\",\"profile\":{\"agreementType\":\"JOB_BASED\",\"stationCount\":3}}" }, "url": "{{baseUrl}}/tenants-create" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('Tenant eklendi',()=>pm.response.to.have.status(201));pm.collectionVariables.set('createdTenantId',b.data.id);"] } }]
        },
        {
          "name": "Geçici CPO Güncelle",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdTenantId}}\",\"name\":\"Postman CPO Güncel\",\"contactEmail\":\"guncel-{{runId}}@test.local\",\"contactPhone\":\"02121111111\",\"status\":\"ACTIVE\",\"profile\":{\"agreementType\":\"ANNUAL\",\"stationCount\":7}}" }, "url": "{{baseUrl}}/tenants-update" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Tenant güncellendi',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Geçici CPO Sil",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdTenantId}}\"}" }, "url": "{{baseUrl}}/tenants-delete" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Tenant silindi',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Bakımnerde Hesapları",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "url": "{{baseUrl}}/users-platform-list" },
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json().data;pm.test('Bakımnerde alanı ayrı',()=>pm.expect(r.every(x=>x.role.startsWith('PLATFORM_'))).to.be.true);"] } }]
        },
        {
          "name": "CPO Hesapları",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "url": "{{baseUrl}}/users-cpo-list" },
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json().data;pm.test('CPO alanı ayrı',()=>pm.expect(r.every(x=>x.role.startsWith('CPO_'))).to.be.true);"] } }]
        },
        {
          "name": "Taşeron ve Mobil Saha Hesapları",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "url": "{{baseUrl}}/users-contractor-list" },
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json().data;pm.test('Mobil saha hesapları görünür',()=>pm.expect(r.some(x=>x.role==='FIELD_WORKER')).to.be.true);"] } }]
        },
        {
          "name": "Mobil Saha Hesabı Ekle",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{contractorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Saha\",\"email\":\"postman-saha-{{runId}}@test.local\",\"phone\":\"05550000000\",\"role\":\"FIELD_WORKER\",\"password\":\"Postman!2026\"}" }, "url": "{{baseUrl}}/users-create" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('Saha hesabı eklendi',()=>pm.response.to.have.status(200));pm.collectionVariables.set('createdUserId',b.data.id);"] } }]
        },
        {
          "name": "Mobil Saha Hesabı Güncelle",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{contractorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdUserId}}\",\"name\":\"Postman Saha Güncel\",\"email\":\"postman-saha-{{runId}}@test.local\",\"phone\":\"05551111111\",\"role\":\"FIELD_WORKER\",\"status\":\"ACTIVE\"}" }, "url": "{{baseUrl}}/users-update" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Saha hesabı güncellendi',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Mobil Saha Hesabı Sil",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{contractorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdUserId}}\"}" }, "url": "{{baseUrl}}/users-delete" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Saha hesabı silindi',()=>pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "03 · CPO → Bakımnerde → Taşeron Akışı",
      "item": [
        {
          "name": "Cihaz-İstasyon Haritası",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "header": [{ "key": "X-API-Version", "value": "1" }], "url": "{{baseUrl}}/charge-points-list" },
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json().data;pm.test('Cihaz istasyon, il ve ilçe ile mapli',()=>{pm.response.to.have.status(200);pm.expect(r[0]).to.have.nested.property('station.name');pm.expect(r[0]).to.have.nested.property('station.city');pm.expect(r[0]).to.have.nested.property('station.district');});"] } }]
        },
        {
          "name": "Cihazlar ve İstasyonlar Listesi",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "header": [{ "key": "X-API-Version", "value": "1" }], "url": "{{baseUrl}}/stations-list" },
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json().data;pm.test('İstasyonlar bağlı cihaz sayısıyla gelir',()=>{pm.response.to.have.status(200);pm.expect(r[0]).to.have.property('deviceCount');pm.expect(r[0]).to.have.property('name');});"] } }]
        },
        {
          "name": "CPO İstasyon Ekler",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Şarj İstasyonu\",\"city\":\"İstanbul\",\"district\":\"Kadıköy\"}" }, "url": "{{baseUrl}}/stations-create" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('CPO istasyon ekledi',()=>pm.response.to.have.status(200));pm.collectionVariables.set('createdStationId',b.data.id);"] } }]
        },
        {
          "name": "CPO İstasyona Cihaz Kodu Ekler",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"stationId\":\"{{createdStationId}}\",\"externalId\":\"PM-CHG-{{runId}}\"}" }, "url": "{{baseUrl}}/charge-points-create" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('Yalnız cihaz kodu kaydedildi',()=>pm.response.to.have.status(200));pm.collectionVariables.set('createdChargePointId',b.data.id);"] } }]
        },
        {
          "name": "DB Uyumlu İş Sayısı",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "header": [{ "key": "X-API-Version", "value": "1" }], "url": "{{baseUrl}}/jobs-summary" },
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json().data;pm.test('Menü sayısı DB özetinden geliyor',()=>{pm.response.to.have.status(200);pm.expect(r.total).to.be.a('number');pm.expect(r.active).to.be.at.most(r.total);});"] } }]
        },
        {
          "name": "CPO Verilen Süreli ve Randevulu İş Ekler",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"cpoTenantId\":\"{{cpoTenantId}}\",\"maintenanceTarget\":\"DEVICE\",\"stationName\":\"Postman Şarj İstasyonu\",\"city\":\"İstanbul\",\"district\":\"Kadıköy\",\"chargerExternalId\":\"PM-CHG-{{runId}}\",\"givenDurationAt\":\"{{futureGivenDuration}}\",\"appointmentAt\":\"{{futureAppointment}}\",\"comment\":\"Postman manuel iş yorumu\"}" }, "url": "{{baseUrl}}/jobs-create" },
          "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json();pm.test('CPO cihaz koduyla işi ekledi',()=>pm.response.to.have.status(200));pm.collectionVariables.set('createdJobId',b.data.id);"] } }]
        },
        {
          "name": "CPO Verilen Süreyi Günceller",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdJobId}}\",\"givenDurationAt\":\"{{futureGivenDuration}}\"}" }, "url": "{{baseUrl}}/jobs-given-duration-update" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Verilen Süre yalnız CPO tarafından güncellendi',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "CPO Varsayılan Randevuyu Günceller",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdJobId}}\",\"appointmentAt\":\"{{futureAppointment}}\"}" }, "url": "{{baseUrl}}/jobs-appointment-update" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Randevu verilen süre içinde güncellendi',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Bakımnerde İş Parametrelerini Düzenler",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdJobId}}\",\"cpoTenantId\":\"{{cpoTenantId}}\",\"maintenanceTarget\":\"DEVICE\",\"stationName\":\"Postman Şarj İstasyonu\",\"city\":\"İstanbul\",\"district\":\"Kadıköy\",\"chargerExternalId\":\"PM-CHG-{{runId}}\",\"appointmentAt\":\"{{futureAppointment}}\",\"comment\":\"Bakımnerde tarafından düzenlenen iş yorumu\",\"cpoPrice\":14800,\"contractorCost\":6500}" }, "url": "{{baseUrl}}/jobs-update" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Düzenle endpointi iş parametrelerini kaydetti',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Bakımnerde Taşerona Atar ve Fiyatlar",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdJobId}}\",\"contractorTenantId\":\"{{contractorTenantId}}\",\"appointmentAt\":\"{{futureAppointment}}\",\"cpoPrice\":14800,\"contractorCost\":6500}" }, "url": "{{baseUrl}}/jobs-assign" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Ata endpointi bir günlük kabul süresini başlattı',()=>pm.response.to.have.status(200));"] } }]
        },
