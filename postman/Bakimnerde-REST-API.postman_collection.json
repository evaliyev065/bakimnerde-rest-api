          "name": "Taşeron Saha Personelini Atar",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{contractorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-API-Version", "value": "1" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdJobId}}\",\"fieldWorkerUserId\":\"{{fieldUserId}}\"}" }, "url": "{{baseUrl}}/jobs-field-worker-assign" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Saha personeli atandı',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Taşeron Randevuyla Onaylar",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{contractorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"id\":\"{{createdJobId}}\",\"appointmentAt\":\"{{futureAppointment}}\"}" }, "url": "{{baseUrl}}/jobs-assignment-accept" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Randevu ve kesinti bildirimi oluştu',()=>pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "İş Üç Tarafta Canlı Görünür",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{cpoToken}}", "type": "string" }] }, "url": "{{baseUrl}}/jobs-list" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('CPO kendi işini görüyor',()=>pm.expect(pm.response.json().data.some(x=>x.documentId===pm.collectionVariables.get('createdJobId'))).to.be.true);"] } }]
        },
        {
