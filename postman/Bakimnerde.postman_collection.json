{
  "info": {
    "_postman_id": "2b8c33f5-7a74-4e97-9de0-bakimnerde001",
    "name": "Bakımnerde API",
    "description": "Bakımnerde statik tek-segment API sözleşmesi. Kimlik, filtre veya işlem verisi URL'ye eklenmez.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'X-API-Version', value: pm.environment.get('apiVersion') || '1' });",
          "pm.request.headers.upsert({ key: 'X-Request-Id', value: pm.environment.get('requestId') || 'postman-manual-001' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Platform Health",
      "item": [
        {
          "name": "Health Live",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health-live", "host": ["{{baseUrl}}"], "path": ["health-live"] },
            "description": "API prosesinin ayakta olduğunu doğrular. Body yoktur."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Liveness alanları doğru', () => { pm.expect(json.data).to.eql({ status: 'alive', service: 'bakimnerde-api' }); });",
            "pm.test('Meta ve header doğru', () => { pm.expect(json.meta.apiVersion).to.eql('1'); pm.expect(json.meta.requestId).to.eql(pm.response.headers.get('x-request-id')); });",
            "pm.test('Teknoloji headerı sızmıyor', () => pm.expect(pm.response.headers.has('x-powered-by')).to.eql(false));"
          ] } }]
        },
        {
          "name": "Health Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health-ready", "host": ["{{baseUrl}}"], "path": ["health-ready"] },
            "description": "Bu dilimde yalnız configuration readiness kontrol edilir. Body yoktur."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Readiness kapsamı doğru', () => { pm.expect(json.data.status).to.eql('ready'); pm.expect(json.data.checks).to.eql({ configuration: 'ready' }); });"
          ] } }]
        },
        {
          "name": "Query String Yasak",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health-live?id=123", "host": ["{{baseUrl}}"], "path": ["health-live"], "query": [{ "key": "id", "value": "123" }] },
            "description": "Negatif test: URL query verisi kesin olarak reddedilmelidir."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
            "const json = pm.response.json();",
            "pm.test('Doğru hata kodu', () => pm.expect(json.error.code).to.eql('URL_PARAMETERS_NOT_ALLOWED'));",
            "pm.test('Stack sızmıyor', () => pm.expect(json.stack).to.eql(undefined));"
          ] } }]
        },
        {
          "name": "Nested Path Yasak",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health-live/extra", "host": ["{{baseUrl}}"], "path": ["health-live", "extra"] },
            "description": "Negatif test: birden fazla route segmenti endpoint değildir."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
            "pm.test('Endpoint bulunamadı', () => pm.expect(pm.response.json().error.code).to.eql('ENDPOINT_NOT_FOUND'));"
          ] } }]
        },
        {
          "name": "Bilinmeyen Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/unknown", "host": ["{{baseUrl}}"], "path": ["unknown"] },
            "description": "Standart JSON 404 zarfını doğrular."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
            "const json = pm.response.json();",
            "pm.test('Standart hata zarfı', () => { pm.expect(json.error.code).to.eql('ENDPOINT_NOT_FOUND'); pm.expect(json.meta.requestId).to.be.a('string'); pm.expect(json.meta.apiVersion).to.eql('1'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "01 - HTTP Method Contract",
      "item": [
        {
          "name": "PUT Yasak",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"forbidden\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/health-live", "host": ["{{baseUrl}}"], "path": ["health-live"] },
            "description": "Negatif sözleşme testi: iş işlemlerinde PUT desteklenmez."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 405', () => pm.response.to.have.status(405));",
            "pm.test('Metot hata sözleşmesi', () => pm.expect(pm.response.json().error.code).to.eql('API_METHOD_NOT_ALLOWED'));",
            "pm.test('Allow header', () => pm.expect(pm.response.headers.get('allow')).to.eql('GET, POST'));"
          ] } }]
        },
        {
          "name": "PATCH Yasak",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"forbidden\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/health-live", "host": ["{{baseUrl}}"], "path": ["health-live"] },
            "description": "Negatif sözleşme testi: iş işlemlerinde PATCH desteklenmez."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 405', () => pm.response.to.have.status(405));",
            "pm.test('Metot hata sözleşmesi', () => pm.expect(pm.response.json().error.code).to.eql('API_METHOD_NOT_ALLOWED'));"
          ] } }]
        },
        {
          "name": "DELETE Yasak",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"forbidden\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/health-live", "host": ["{{baseUrl}}"], "path": ["health-live"] },
            "description": "Negatif sözleşme testi: iş işlemlerinde DELETE desteklenmez."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 405', () => pm.response.to.have.status(405));",
            "pm.test('Metot hata sözleşmesi', () => pm.expect(pm.response.json().error.code).to.eql('API_METHOD_NOT_ALLOWED'));"
          ] } }]
        }
      ]
    }
  ]
}
