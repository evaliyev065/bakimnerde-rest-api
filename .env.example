# Bakımnerde REST API — güvenli development örneği
# Bu dosyayı `.env` adıyla kopyalayın. Gerçek secret değerlerini commit etmeyin.
# Uygulama .env olmadan development varsayılanlarıyla çalışabilir; başlangıçta açık uyarı üretir.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_VERSION=1
LOG_LEVEL=info
