# Bakımnerde REST API — güvenli development örneği
# Bu dosyayı `.env` adıyla kopyalayın. Gerçek secret değerlerini commit etmeyin.
# Uygulama .env olmadan development varsayılanlarıyla çalışabilir; başlangıçta açık uyarı üretir.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_VERSION=1
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=bakimnerde
AUTH_TOKEN_SECRET=buraya-en-az-32-karakterlik-guclu-bir-deger-yazin
CORS_ORIGIN=http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175,http://localhost:4173,http://localhost:4174,http://localhost:4175,https://localhost,https://contractor-registrations.bakimnerde.com
